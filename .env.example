# Copiar a .env antes de `docker compose up`. NO subir .env al repositorio.

# Secreto HS256 compartido por el gateway y los servicios (mínimo 32 caracteres)
JWT_SECRET=cambia-este-secreto-por-uno-largo-de-al-menos-32-caracteres

RABBITMQ_USER=saberpro
RABBITMQ_PASSWORD=saberpro123

DB_USERS_USER=users_app
DB_USERS_PASSWORD=users_pass
DB_QUESTIONS_USER=questions_app
DB_QUESTIONS_PASSWORD=questions_pass
DB_SIMULATIONS_USER=simulations_app
DB_SIMULATIONS_PASSWORD=simulations_pass
DB_TRACKING_USER=tracking_app
DB_TRACKING_PASSWORD=tracking_pass

# Administrador inicial que crea el user-service al arrancar si no existe
ADMIN_LOGIN=admin
ADMIN_PASSWORD=Admin123*
